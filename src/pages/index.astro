---
import Base from '../layouts/Base.astro';
---
<Base title="Spencer Morby — Are you looking, or are you leaving?" description="Estate agent in Randpark Ridge, Weltevreden Park and Sundowner since 1989. Choose a road: buying or selling." journey="buying">
<canvas id="gl"></canvas><div class="grain"></div>
<div class="wipe" id="wipe"></div>
<div id="ld"><div><div class="n" id="ldn">0</div><div class="s">Years on these streets</div></div><div class="bar" id="ldb"></div></div>
<div class="q"><h1>Are you <em>looking,</em><br>or are you <em>leaving?</em></h1><p class="who"><b>Spencer Morby</b>Randpark Ridge, Weltevreden Park and Sundowner. Thirty-seven years. Turn one way and I'll show you the streets. Turn the other and we'll park outside your house.</p></div>
<a class="road l" id="roadL" href="/buying"><div class="in"><div class="lab">Turn left · I'm looking</div><h2>Show me the <em>streets.</em></h2><svg class="arrow" viewBox="0 0 48 24"><path d="M46 12H4M14 3L4 12l10 9"/></svg></div></a>
<a class="road r" id="roadR" href="/selling"><div class="in"><div class="lab">Turn right · I'm selling</div><h2>Park outside <em>my house.</em></h2><svg class="arrow" viewBox="0 0 48 24"><path d="M2 12h42M34 3l10 9-10 9"/></svg></div></a>
<div class="mid" id="mid"><i></i>Choose a road</div>
<div class="back" id="back"><span id="backTxt">Welcome back. Last time you were selling.</span><button id="backGo">Carry on</button><a href="#" id="backSwitch">Switch</a></div>
<script>
  import { mount } from '../scenes/fork.js';
  mount();
</script>
</Base>
<style is:global>
.road{text-decoration:none}

#gl{position:fixed;inset:0;z-index:0}
#ld{position:fixed;inset:0;z-index:100;background:var(--bg);display:grid;place-items:center}
#ld .n{font-family:Newsreader,serif;font-style:italic;font-weight:300;font-size:clamp(5rem,16vw,14rem);line-height:.9;color:var(--tq-d);letter-spacing:-.04em;text-align:center}
#ld .s{font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-top:1.2rem;text-align:center}
#ld .bar{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--tq);transform:scaleX(0);transform-origin:left}
nav{position:fixed;top:0;left:0;right:0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:1.4rem 2rem;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;opacity:0}
nav .r{display:flex;gap:1.8rem}
.q{position:fixed;left:2rem;top:14vh;z-index:20;opacity:0;padding:2rem 3rem 2rem 0;background:radial-gradient(110% 100% at 0% 50%,rgba(238,240,239,.96) 55%,rgba(238,240,239,0) 100%)}
.q h1{font-size:clamp(2.6rem,6.4vw,7rem);line-height:.9;letter-spacing:-.04em;font-weight:500;max-width:12ch}
.q h1 em{font-family:Newsreader,serif;font-style:italic;font-weight:300;color:var(--tq-d);letter-spacing:-.01em}
.q .who{margin-top:1.4rem;font-size:.9rem;line-height:1.6;color:#3A4240;max-width:34ch}
.q .who b{display:block;font-weight:500;color:var(--ink)}
/* the two roads */
.road{position:fixed;bottom:0;top:0;width:50%;z-index:10;cursor:pointer;display:flex;align-items:flex-end;padding:0 2rem 9vh;opacity:0}
.road.l{left:0}.road.r{right:0;justify-content:flex-end;text-align:right}
.road .lab{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:.8rem;transition:color .3s}
.road h2{font-size:clamp(2rem,4.4vw,4.6rem);line-height:.95;letter-spacing:-.035em;font-weight:500;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.road h2 em{font-family:Newsreader,serif;font-style:italic;font-weight:300;color:var(--tq-d)}
.road .arrow{display:block;width:3rem;height:1.5rem;margin-top:1rem;opacity:.5;transition:opacity .3s,transform .5s cubic-bezier(.2,.8,.2,1)}
.road.r .arrow{margin-left:auto}
.road .arrow path{fill:none;stroke:var(--ink);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.road:hover .lab{color:var(--tq-d)}.road:hover h2{transform:translateY(-.4rem)}.road:hover .arrow{opacity:1;transform:translateX(0)}.road.l:hover .arrow{transform:translateX(-.6rem)}.road.r:hover .arrow{transform:translateX(.6rem)}
.road .in{max-width:22rem;padding:1.6rem 0;background:radial-gradient(120% 100% at 50% 100%,rgba(238,240,239,.95) 50%,rgba(238,240,239,0) 100%)}
.mid{position:fixed;left:50%;bottom:9vh;transform:translateX(-50%);z-index:12;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);opacity:0;text-align:center}
.mid i{display:block;width:1px;height:2.4rem;background:var(--ink);margin:0 auto .6rem;opacity:.5}
/* welcome back */
.back{position:fixed;left:50%;bottom:2rem;transform:translate(-50%,300%);opacity:0;z-index:40;background:var(--ink);color:var(--bg);padding:.9rem .9rem .9rem 1.4rem;border-radius:99px;display:flex;align-items:center;gap:1.2rem;font-size:.85rem;white-space:nowrap}
.back button{all:unset;cursor:pointer;background:var(--tq);color:var(--ink);padding:.55rem 1rem;border-radius:99px;font-weight:500;font-size:.8rem}
.back a{color:var(--bg);opacity:.6;text-decoration:none;font-size:.8rem}
.wipe{position:fixed;inset:0;z-index:90;background:var(--ink);transform:scaleY(0);transform-origin:bottom;pointer-events:none}
@media(max-width:820px){.q{top:10vh;left:1.2rem;right:1.2rem}.q h1{font-size:clamp(2.2rem,11vw,4rem)}.q .who{display:none}.road{padding:0 1.2rem 6vh}.road h2{font-size:clamp(1.4rem,6.4vw,2.4rem)}.road .lab{font-size:.6rem}.mid{display:none}nav .r{display:none}}

</style>
