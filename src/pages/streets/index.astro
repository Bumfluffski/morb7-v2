---
import Base from '../../layouts/Base.astro';
import { suburbs } from '../../data/suburbs.js';
const list = Object.entries(suburbs);
---
<Base title="The three suburbs — Spencer Morby" description="Randpark Ridge, Weltevreden Park and Sundowner: what the public record says about each, and what only an agent who has watched them since 1989 can add." journey="buying" fixedNav={false}>
<div class="wrap">
  <header class="hero"><p class="k">The suburbs</p><h1>Three suburbs. <em>Only three.</em></h1><p class="lede">I have worked these and nowhere else since 1989. Each page below has two layers: what the public record says, cited, and what I tell you in the car.</p></header>
  <div class="cards">
    {list.map(([slug, s]) => <a href={`/streets/${slug}`} class="card"><span class="k">{s.region} · {s.code}</span><h2>{s.name}</h2><p>{s.lede}</p><span class="go">Read the record →</span></a>)}
  </div>
</div>
</Base>
<style is:global>
.nav{position:static;padding:1.4rem 0;width:min(100% - 3rem,72rem);margin-inline:auto}
.wrap{width:min(100% - 3rem,72rem);margin-inline:auto;padding-bottom:10vh}
.hero{padding:8vh 0 3rem;border-bottom:1.5px solid var(--ink)}
.k{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--tq-d)}
h1{margin-top:1rem;font-size:clamp(2.4rem,5vw,5.2rem);line-height:.95;letter-spacing:-.04em;font-weight:500}
h1 em{font-family:Newsreader,serif;font-style:italic;font-weight:300;color:var(--tq-d)}
.lede{margin-top:1.6rem;font-size:1.2rem;line-height:1.5;max-width:56ch;color:#3A4240}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-bottom:1.5px solid var(--ink)}
.card{display:flex;flex-direction:column;gap:1rem;padding:2.4rem 2rem 2.4rem 0;border-right:1px solid var(--rule);text-decoration:none;transition:background .25s}
.card:last-child{border-right:0}.card+.card{padding-left:2rem}
.card h2{font-size:2.2rem;letter-spacing:-.03em;font-weight:500;line-height:1}
.card p{font-family:Newsreader,serif;font-size:1.1rem;line-height:1.5;color:#3A4240;flex:1}
.card .go{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;border-bottom:1.5px solid var(--tq);align-self:flex-start}
.card:hover{background:#E4F6F5}
@media(max-width:860px){.cards{grid-template-columns:1fr}.card{border-right:0;border-bottom:1px solid var(--rule);padding-left:0}.card+.card{padding-left:0}}
</style>
