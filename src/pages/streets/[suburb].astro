---
import Base from '../../layouts/Base.astro';
import { suburbs } from '../../data/suburbs.js';
export function getStaticPaths() { return Object.keys(suburbs).map(suburb => ({ params: { suburb }, props: suburbs[suburb] })); }
const { name, code, region, lede, sections } = Astro.props;
const current = Astro.params.suburb;
const all = Object.entries(suburbs).map(([slug, s]) => ({ slug, name: s.name }));
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'Place', name: `${name}, Johannesburg`, description: lede, address: { '@type': 'PostalAddress', addressLocality: 'Johannesburg', addressRegion: 'Gauteng', postalCode: code, addressCountry: 'ZA' } },
    { '@type': 'Article', headline: `${name}: the record, and the street`, author: { '@id': 'https://morb7.co.za/#spencer' }, publisher: { '@id': 'https://morb7.co.za/#agency' }, about: `${name}, Johannesburg` },
    { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'The suburbs', item: 'https://morb7.co.za/streets/randpark-ridge' }, { '@type': 'ListItem', position: 2, name } ] }
  ] };
---
<Base title={`${name}: the record, and the street — Spencer Morby`} description={lede} journey="buying" fixedNav={false} schema={schema}>
<div class="wrap">
  <header class="hero">
    <nav class="sw" aria-label="Switch suburb">{all.map(s => <a href={`/streets/${s.slug}`} class={s.slug===current?"on":""} aria-current={s.slug===current?"page":undefined}>{s.name}</a>)}</nav>
    <p class="k">{region} · {code}</p>
    <h1>What is known about <em>{name}</em>. And what only I know.</h1>
    <p class="lede">{lede}</p>
    <div class="key"><span><i class="r"></i>The record: public, cited, checkable</span><span><i class="s"></i>The street: what I tell you in the car</span></div>
  </header>
  <div class="grid">
    <aside class="side">{sections.map(s => <a href={'#'+s.id}>{s.h}</a>)}</aside>
    <div class="body">
      {sections.map(s => (
        <section id={s.id} class="sec">
          <h2>{s.h}</h2>
          <div class="record"><span class="tag">The record</span><div set:html={s.record} /></div>
          <div class="street"><span class="tag">The street</span>
            {s.street ? <div set:html={s.street} /> : <div class="todo"><p class="q">{s.q}</p><p class="w">Spencer has not answered this one yet. Nothing goes here until he has.</p></div>}
          </div>
        </section>
      ))}
      <nav class="next" aria-label="Other suburbs">{all.filter(s=>s.slug!==current).map(s => <a href={`/streets/${s.slug}`}><span>Next door</span>{s.name}</a>)}</nav>
      <p class="ask">If your street is one of these, <a href="/selling">park outside it with me</a>, or <a href="/buying">drive it</a>.</p>
    </div>
  </div>
</div>
</Base>
<style is:global>
.nav{position:static;padding:1.4rem 0;width:min(100% - 3rem,72rem);margin-inline:auto}
.wrap{width:min(100% - 3rem,72rem);margin-inline:auto;padding-bottom:10vh}
.hero{padding:8vh 0 3rem;border-bottom:1.5px solid var(--ink)}
.sw{display:inline-flex;border:1.5px solid var(--ink);border-radius:99px;overflow:hidden;margin-bottom:1.6rem}
.sw a{padding:.6rem 1.1rem;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;font-weight:500;text-decoration:none;transition:background .25s,color .25s}
.sw a:hover{background:var(--wash,#E4F6F5)}
.sw a.on{background:var(--ink);color:var(--bg)}
.next{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:0 0 2.4rem}
.next a{border:1.5px solid var(--ink);padding:1.2rem 1.4rem;text-decoration:none;font-size:1.4rem;letter-spacing:-.02em;font-weight:500;transition:background .25s,color .25s}
.next a span{display:block;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:.3rem}
.next a:hover{background:var(--ink);color:var(--bg)}
.k{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--tq-d);margin-bottom:1rem}
h1{font-size:clamp(2.4rem,5vw,5.2rem);line-height:.95;letter-spacing:-.04em;font-weight:500;max-width:18ch}
h1 em{font-family:Newsreader,serif;font-style:italic;font-weight:300;color:var(--tq-d)}
.lede{margin-top:1.6rem;font-size:1.2rem;line-height:1.5;max-width:60ch;color:#3A4240}
.key{display:flex;gap:2rem;margin-top:2rem;font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--dim)}
.key i{display:inline-block;width:.7rem;height:.7rem;margin-right:.5rem;vertical-align:-1px;border:1.5px solid var(--ink)}
.key i.s{border-color:var(--tq);border-style:dashed}
.grid{display:grid;grid-template-columns:14rem 1fr;gap:4rem;padding-top:3rem}
.side{position:sticky;top:2rem;align-self:start;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
.side a{display:block;text-decoration:none;padding:.4rem 0;border-top:1px solid var(--rule)}.side a:last-child{border-bottom:1px solid var(--rule)}
.body{max-width:66ch}
.sec{padding:0 0 3rem;margin-bottom:3rem;border-bottom:1px solid var(--rule)}
h2{font-size:2rem;letter-spacing:-.03em;font-weight:500;margin-bottom:1.4rem;line-height:1.05}
.tag{display:block;font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:.8rem}
.record{border-left:1.5px solid var(--ink);padding-left:1.4rem;margin-bottom:2rem}
.record p{font-family:Newsreader,serif;font-size:1.22rem;line-height:1.55;margin-bottom:1rem}
.record a{font-family:"Familjen Grotesk";font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--tq-d);text-decoration:none;border-bottom:1px solid var(--tq)}
.street{border-left:1.5px dashed var(--tq);padding-left:1.4rem}
.street .tag{color:var(--tq-d)}
.todo .q{font-family:Newsreader,serif;font-style:italic;font-weight:300;font-size:1.35rem;line-height:1.3;color:var(--ink)}
.todo .w{margin-top:.6rem;font-size:.85rem;color:var(--dim)}
.ask{font-family:Newsreader,serif;font-size:1.3rem;font-style:italic;font-weight:300;color:var(--tq-d)}
.ask a{color:var(--ink);font-style:normal;font-family:"Familjen Grotesk";font-size:1rem;text-decoration:none;border-bottom:1.5px solid var(--tq)}
@media(max-width:860px){.sw a{padding:.55rem .7rem;font-size:.66rem}.next{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.side{display:none}.key{flex-direction:column;gap:.6rem}}
</style>
